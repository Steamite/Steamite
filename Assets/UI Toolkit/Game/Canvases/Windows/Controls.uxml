<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/Global/Button.uss?fileID=7433441132597879392&amp;guid=9c069573d2a1ca645bcaf03cbee89a38&amp;type=3#Button"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/Window.uss?fileID=7433441132597879392&amp;guid=a52c4c079ba57c5419681c2f3af6656f&amp;type=3#Window"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/Save%20window.uss?fileID=7433441132597879392&amp;guid=eca73d8699a9e1c41a8dd8849b9c0de9&amp;type=3#Save window"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/Global/UnitySelectors.uss?fileID=7433441132597879392&amp;guid=3468915a4f8821544854e970a313de3c&amp;type=3#UnitySelectors"/>
    <ui:VisualElement name="Load-Menu" enabled="true" class="game-window">
        <ui:VisualElement name="Background" class="menu-view" style="width: 100%; position: relative;">
            <ui:VisualElement name="Header-Bar" class="bar">
                <ui:Button text="Close" tooltip="Close" name="Save-Close-Button" class="close-button"/>
                <ui:Label text="Help" name="Load-Header" class="title" style="opacity: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Body" style="flex-direction: column; justify-content: flex-start; max-height: 90%; flex-grow: 1; padding-top: 15px; padding-right: 15px; padding-bottom: 15px; padding-left: 15px;">
                <ui:TabView style="font-size: 40px;">
                    <ui:Tab label="Week 1" name="Week2">
                        <ui:ScrollView>
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label text="Tile toggle" name="Rocks"/>
                                <ui:Label text="- use &quot;H&quot; to enter toggle mode&#10;- when you hover over and hold left mouse button, any tile while in toggle mode it changes tile to rock or road" style="font-size: 30px; -unity-font-style: normal; white-space: normal;"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label text="Human Pathing" name="Rocks"/>
                                <ui:Label text="- click on any road&#10;- all humans will move to their origin &#10;- and those that found a way to the clicked position will move there&#10;- (creates a nice ripple effect but will be removed in the future)" style="font-size: 30px; -unity-font-style: normal; white-space: normal;"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label text="Rock hiding" name="Rocks"/>
                                <ui:Label text="- you may notice that some rock tiles are black and some are not&#10;- black are the &quot;hidden&quot;, and can be revealed by nearby roads&#10;- after being revealed, there&apos;s no point to hide revealed rocks (in the planned gameplay)" style="font-size: 30px; -unity-font-style: normal; white-space: normal;"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label text="Building removing" name="Rocks"/>
                                <ui:Label text="- use &quot;Delete&quot;  to enter deconstruction mode&#10;- when you click on a building it will get removed " style="font-size: 30px; -unity-font-style: normal; white-space: normal;"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label text="Map generation changes" name="Rocks"/>
                                <ui:Label text="- I use perlin noise to remove some rocks in generation for easier pathfind tests" style="font-size: 30px; -unity-font-style: normal; white-space: normal;"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label text="Level switching" name="Rocks"/>
                                <ui:Label text="- use the top buttons &#10;- or &quot;4&quot;, &quot;5&quot;, ...&#10;- change the active ground level&#10;- each level is now independent&#10;- next update, moving between floors" style="font-size: 30px; -unity-font-style: normal; white-space: normal;"/>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:Tab>
                    <ui:Tab label="Week 2">
                        <ui:Label text="Minimal visible Changes.&#10;Bug fixes with buildings.&#10;Human movement source data rewrite.&#10;"/>
                    </ui:Tab>
                    <ui:Tab label="Week 3">
                        <ui:Label text="&lt;b&gt;Dig&lt;/b&gt;&#10;Use the &quot;G&quot; to mark tiles for humans to remove. &#10;!Mark only reacheble ones!&#10;&#10;&lt;b&gt;Vertical Movement&lt;/b&gt;&#10;Build the first building in the first category (elevator) to allow  travel&#10;between levels. &#10;Must match the center tile(use shift and level shortcuts)"/>
                    </ui:Tab>
                </ui:TabView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
