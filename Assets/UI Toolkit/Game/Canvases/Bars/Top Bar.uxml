<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Controls" src="project://database/Assets/UI%20Toolkit/Game/Canvases/Windows/Controls.uxml?fileID=9197481963319205126&amp;guid=571ad8fec4ea5d347bd18f59c4338992&amp;type=3#Controls"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/TopBar.uss?fileID=7433441132597879392&amp;guid=4fe123aa2d844744b9e1a00d21362590&amp;type=3#TopBar"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/StatusBar.uss?fileID=7433441132597879392&amp;guid=b591f8d887031d24b933f7e2268f24d0&amp;type=3#StatusBar"/>
    <Style src="project://database/Assets/UI%20Toolkit/Styles/Top%20Bar/Overlay.uss?fileID=7433441132597879392&amp;guid=79d14677e56132347a4c0420dee1517e&amp;type=3#Overlay"/>
    <engine:VisualElement name="TopBar" class="topBar" style="overflow: visible; justify-content: center;">
        <engine:VisualElement name="time-container" style="flex-direction: row; position: absolute; left: 0; height: 100%; align-self: flex-start;">
            <engine:VisualElement name="TimeDisplay" class="time">
                <engine:VisualElement class="time-part">
                    <engine:Label text="00" name="Hour" style="border-left-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; width: 60px;"/>
                    <engine:Label text=":" name="Separator" style="padding-bottom: 8px;"/>
                    <engine:Label text="00" name="Minute" style="width: 60px;"/>
                </engine:VisualElement>
                <engine:VisualElement class="time-part" style="flex-grow: 1; flex-direction: row;">
                    <engine:Label text="00." name="Day" style="width: 65px;"/>
                    <engine:Label text="00." name="Month" style="width: 65px;"/>
                </engine:VisualElement>
                <engine:VisualElement class="time-part" style="flex-grow: 1;">
                    <engine:Label text="1856" name="Year" style="width: 100px;"/>
                </engine:VisualElement>
            </engine:VisualElement>
            <TimeButtons speed-states="0,1,2,3" current-state="2" name="Buttons" sprite="project://database/Assets/Resources/Icon/Pause.png?fileID=2800000&amp;guid=388d058ebff7c4844823b4c308f1488e&amp;type=3#Pause"/>
        </engine:VisualElement>
        <engine:VisualElement name="trust-container" picking-mode="Ignore" style="height: 100%; justify-content: center; align-self: center;">
            <engine:ProgressBar value="75" title="50/100" name="Trust" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 300px; font-size: 20px; position: relative; align-self: center; height: 35px;"/>
        </engine:VisualElement>
        <engine:Button text="?" name="help-button" class="status-bar-button" style="background-image: none; left: 754px; position: absolute; top: 5px;"/>
        <engine:VisualElement name="Right" style="right: 0; position: absolute; flex-direction: row;">
            <ResourceOverview name="Resources" style="flex-direction: row; align-self: stretch; padding-left: 0; margin-right: 10px; margin-left: 0; justify-content: space-between; height: 100%; align-items: center;"/>
            <LevelButtons name="LevelButtons" levels="0,1,2,3,4,5" style="flex-direction: row; position: relative; flex-grow: 0; right: 0; top: 0;"/>
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="Money-Background" class="small-window" style="position: relative;">
        <engine:Label text="##### &lt;color=#FFD700&gt;£&lt;/color&gt;" name="Money-Value" class="money"/>
    </engine:VisualElement>
    <OverlayButtons name="OverlayButtons" style="position: absolute; top: 8%; right: 0; flex-grow: 0; background-color: rgba(46, 46, 46, 0.247);"/>
    <engine:Instance template="Controls" name="Controlls" style="position: absolute; height: 100%; width: 100%; display: none;"/>
</engine:UXML>
